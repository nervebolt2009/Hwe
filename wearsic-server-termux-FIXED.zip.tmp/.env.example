# Public port for the local server. Point Cloudflare Tunnel to this port.
PORT=8080
# SQLite file path. Defaults to wearsic.db in the server directory.
WEARSIC_DB_PATH=wearsic.db
# Optional shared key. Configure the same key in Wearsic Settings.
WEARSIC_API_KEY=
# Optional authenticated YouTube browser cookie string for bot-challenged server IPs.
# Never commit a real cookie. Example format: SID=...; HSID=...; SSID=...
WEARSIC_YOUTUBE_COOKIE=
