# Gateway listener
PORT=8081
HOST=0.0.0.0

# Persistent data and authentication
WEARSIC_DB_PATH=wearsic-server-v2.db
WEARSIC_API_KEY=replace-with-a-long-random-secret

# Existing NewPipe-based server
WEARSIC_PRIMARY_URL=http://127.0.0.1:8080

# Backup extractor
WEARSIC_YTDLP_BIN=yt-dlp
WEARSIC_MAX_CONCURRENT_EXTRACTIONS=2

# Reliability and caching
WEARSIC_REQUEST_TIMEOUT_SECONDS=30
WEARSIC_CACHE_TTL_SECONDS=21600
WEARSIC_FAILURE_THRESHOLD=3
WEARSIC_RECOVERY_THRESHOLD=3
# Seconds between primary recovery probes while the backup engine is active.
WEARSIC_PROBE_INTERVAL_SECONDS=30
WEARSIC_RESTART_DELAY_SECONDS=5
WEARSIC_MAX_RESTART_DELAY_SECONDS=300
WEARSIC_SKIP_INSTALL=0
