<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup & device-transfer rules (API 31+). DataStore holds the API key and
  the private server URL — neither must ever leave the device in a backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/wearsic_settings.preferences_pb" />
        <exclude domain="root" path="datastore/wearsic_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/wearsic_settings.preferences_pb" />
        <exclude domain="root" path="datastore/wearsic_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
