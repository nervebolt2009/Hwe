<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud Auto Backup rules (API <= 30). DataStore holds the API key and the
  private server URL — neither must ever leave the device in a backup.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/wearsic_settings.preferences_pb" />
    <exclude domain="root" path="datastore/wearsic_settings.preferences_pb" />
</full-backup-content>
